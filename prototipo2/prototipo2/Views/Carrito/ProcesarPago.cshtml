@{
    ViewData["Title"] = "Compra Confirmada";
}

<div class="page-wrapper min-vh-100 d-flex flex-column justify-content-center align-items-center bg-light py-5">
    <div class="confirm-card text-center p-5 shadow-lg rounded-4 bg-white animate__animated animate__fadeIn">
        <div class="mb-4">
            <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
        </div>

        <h1 class="fw-bold text-success mb-3">¡Pago Confirmado!</h1>
        <p class="lead text-secondary mb-4">
            Gracias por tu compra. Tu pedido ha sido procesado correctamente.
        </p>
        <p class="text-muted">
            Recibirás un correo electrónico con los detalles y el seguimiento del pedido.
        </p>

        <div class="order-details mt-4 p-3 bg-light rounded-3 border">
            <p class="mb-2">
                <i class="bi bi-receipt me-2 text-primary"></i>
                <span class="text-muted">Número de orden:</span>
                <strong>@ViewBag.OrderId</strong>
            </p>
            <p class="mb-0">
                <i class="bi bi-currency-dollar me-2 text-success"></i>
                <span class="text-muted">Monto:</span>
                <strong>@ViewBag.Total.ToString("C2")</strong>
            </p>
        </div>

        <a asp-controller="Home" asp-action="Index"
           class="btn btn-primary btn-lg px-4 fw-semibold mt-4 shadow-sm">
            <i class="bi bi-house-door-fill me-2"></i> Volver al Inicio
        </a>
    </div>

    <footer class="text-center text-muted py-3 mt-4">
        &copy; @DateTime.Now.Year Tu Empresa. Todos los derechos reservados.
    </footer>
</div>

<!-- Animación de Animate.css (opcional) -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
