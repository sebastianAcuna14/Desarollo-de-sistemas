@model IEnumerable<prototipo2.Models.Empleado>

@{
    ViewData["Title"] = "Lista de Productos";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="container-sm py-3 col-11">

        <h1 class="mb-4">@ViewData["Title"]</h1>

        <a asp-controller="Empleado" asp-action="CrearEmpleado" class="btn btn-primary mb-3">Agregar Empleado</a>

        <div class="card mt-5 shadow rounded-4">
            <div class="card-body">
                
                    <table class="table table-striped table-responsive" id="datatablesSimple" style="width:100%">
                    <thead class="table-secondary">
                        <tr>
              
                            <th>Nombre</th>
                            <th>Apellido</th>
                            <th>Cedula</th>
                            <th>Telefono</th> 
                            <th>Correo</th>
                            <th>Contraseña</th>
                            <th>Rol</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var empleado in Model)
                        {
                            <tr>
                                 @* <td>@empleado.IdEmpleado</td> *@
                                <td>@empleado.Nombre</td>
                                <td>@empleado.Apellido</td>
                                <td>@empleado.Cedula</td>
                                <td>@empleado.Telefono</td>
                                <td>@empleado.Correo</td>
                                <td>@empleado.Contrasena</td>
                                <td>@empleado.IdRol</td>
                               
                                <td>
                                    <a asp-controller="Empleado"
                                       asp-action="Editar"
                                       asp-route-id="@empleado.IdEmpleado"
                                       class="btn btn-warning btn-sm">Editar</a>

                                    <a asp-controller="Empleado"
                                       asp-action="Eliminar"
                                       asp-route-id="@empleado.IdEmpleado"
                                       class="btn btn-danger btn-sm">Eliminar</a>

                                 


                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/umd/simple-datatables.min.js"></script>
    <script src="~/js/Empleado.js"></script>
}
