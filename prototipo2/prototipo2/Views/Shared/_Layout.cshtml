<!DOCTYPE html>
<html lang="en">


<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - prototipo2</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/prototipo2.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/Styles.css" rel="stylesheet" />
    <link href="~/css/estilo.css" rel="stylesheet" />

</head>
<body>
    <header class="bg-dark text-white py-3">

        <div class="container">

            <div class="row align-items-center">
                <div class="col-lg-3 mb-3 mb-lg-0 text-center text-lg-start">
                    <a class="text-white text-decoration-none" asp-area="" asp-controller="Home" asp-action="Index">


                        <h1 class="h1 mb-0 text-white d-flex align-items-center justify-content-center justify-content-lg-start">
                            <i class="fas fa-cogs me-2 text-warning"></i>
                            <span>Aplecsa</span>

                        </h1>
                    </a>

                </div>
                <div class="col-lg-5 mb-3 mb-lg-0 d-flex align-items-center justify-content-end gap-4">
                    <!-- Barra de búsqueda -->
                    <form class="flex-grow-1 me-lg-5">
                        <div class="input-group">
                            <input type="text" class="form-control" placeholder="Buscar productos...">
                            <button class="btn btn-warning" type="submit">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </form>

                    <div class="position-absolute top-0 end-0 mt-3 me-5 d-flex align-items-center gap-3">

                        <a class="text-white" asp-area="" asp-controller="Carrito" asp-action="Index">
                            <i class="fas fa-shopping-cart"></i>
                        </a>

                        <a href="#" class="text-white dropdown-toggle" id="navbarDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-user"></i>
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                            <li><a class="dropdown-item" asp-controller="Login" asp-action="Recuperar">Cambiar Contraseña</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" asp-controller="Cliente" asp-action="CerrarSesion">Cerrar Sesión</a></li>
                        </ul>
                    </div>






                </div>
            </div>
        </div>

    </header>
    @RenderBody()

    @*     <div class="container">
        <main role="main" class="pb-3">

        </main>
    </div> *@

    @RenderSection("Scripts", required: false)

    <footer class="bg-dark text-light py-5 mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <h5>Aplecsa</h5>
                    <p>Tu socio confiable en equipos electromecánicos de alta calidad.</p>
                    <div class="social-links">
                        <a href="https://www.facebook.com/aplecsa" class="text-warning me-3"><i class="fab fa-facebook-f"></i></a>
                        <a href="https://api.whatsapp.com/send?phone=50689551997" class="text-warning me-3"><i class="fa-brands fa-whatsapp"></i></a>
                        <a href="https://www.instagram.com/aplecsa_cr?utm_source=ig_web_button_share_sheet&igsh=ZDNlZDc0MzIxNw==" class="text-warning me-3"><i class="fab fa-instagram"></i></a>

                    </div>
                </div>
                <div class="col-md-2 mb-4">
                    <h6>Enlaces</h6>
                    <ul class="list-unstyled">
                        <li><a href="index.html" class="text-light">Inicio</a></li>
                        <li><a href="catalogo.html" class="text-light">Catálogo</a></li>
                        <li><a href="envios.html" class="text-light">Envíos</a></li>
                        <li><a href="contacto.html" class="text-light">Contacto</a></li>
                    </ul>
                </div>
                <div class="col-md-3 mb-4">
                    <h6>Categorías</h6>
                    <ul class="list-unstyled">
                        <li><a href="" class="text-light">Motores</a></li>
                        <li><a href="#" class="text-light">Bombas</a></li>
                        <li><a href="#" class="text-light">Compresores</a></li>
                        <li><a href="#" class="text-light">Generadores</a></li>
                    </ul>
                </div>
                <div class="col-md-3 mb-4">
                    <h6>Contacto</h6>
                    <p><i class="fas fa-map-marker-alt me-2"></i>Paseo Colon, San José, Costa Rica</p>
                    <p><i class="text-white-50 mb-2"><i class="fas fa-phone-alt me-2"></i>(506) 2257-5716</p>
                    <p><i class="fas fa-envelope me-2"></i>servicioalcliente@aplecsa.com</p>
                </div>
            </div>
            <hr class="my-4">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <p class="mb-0">&copy; 2025 Aplecsa. Todos los derechos reservados.</p>
                </div>
                <div class="col-md-6 text-end">
                    <img src="~/images/paypal.png" alt="Métodos de Pago" class="img-fluid" style="max-height: 60px;">
                </div>
            </div>
        </div>
    </footer>



</body>
</html>
