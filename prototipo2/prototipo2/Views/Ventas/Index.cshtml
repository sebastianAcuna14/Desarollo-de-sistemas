@model IEnumerable<prototipo2.Models.Venta>

@{
    ViewData["Title"] = "Ventas";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="container-sm py-3 col-11">

        <h1 class="mb-4">@ViewData["Title"]</h1>

        <a asp-action="Create" class="btn btn-primary mb-3">
            <i class="fas fa-plus me-1"></i> Nueva Venta
        </a>

        <div class="card mt-4 shadow rounded-4">
            <div class="card-body">
                <table id="tablaVentas" class="table table-striped" style="width:100%">
                    <thead class="table-secondary">
                        <tr>
                            <th>Fecha</th>
                            <th>Productos</th>
                            <th>Total</th>
                            <th>Método de Pago</th>
                            <th>Devoluciones</th>
                            <th>Nota de Crédito</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var venta in Model)
                        {
                            <tr>
                                <td>@venta.Fecha.ToShortDateString()</td>
                                <td>
                                    <ul class="mb-0">
                                        @foreach (var prod in venta.Productos)
                                        {
                                            <li>@($"{prod.Producto} (x{prod.Cantidad})")</li>
                                        }
                                    </ul>
                                </td>
                                <td>
                                    @venta.Productos.Sum(p => p.Total).ToString("C")
                                </td>
                                <td>
                                    @{
                                        var tiposPago = venta.Pagos
                                        .Select(p => p.Tipo.Equals("PayPal", StringComparison.OrdinalIgnoreCase) ? "TARJETA" : p.Tipo)
                                        .Distinct();
                                    }
                                    @string.Join(", ", tiposPago)
                                </td>
                                <td>
                                    @if (venta.Devoluciones != null && venta.Devoluciones.Any())
                                    {
                                        <span class="badge bg-warning text-dark">Sí</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No</span>
                                    }
                                </td>
                                <td>
                                    @if (venta.NotaCredito != null)
                                    {
                                        <div><strong>@venta.Devoluciones.First().Motivo</strong></div>
                                        <div>@venta.NotaCredito.Comentario</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@venta.Id" class="btn btn-warning">
                                        Editar
                                    </a>

                                    <form asp-action="Delete" asp-route-id="@venta.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-danger">
                                            Eliminar
                                        </button>
                                    </form>
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/umd/simple-datatables.min.js"></script>
    <script src="~/js/tablaventas.js"></script>
}
