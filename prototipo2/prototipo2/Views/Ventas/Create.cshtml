@model prototipo2.Models.Venta

@{
    ViewData["Title"] = "Nueva Venta";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container mt-5 col-md-8">
    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Registrar Venta</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">

                <div class="mb-3">
                    <label class="form-label">Producto</label>
                    <input name="Productos[0].Producto" class="form-control" placeholder="Nombre del producto" />
                    <span asp-validation-for="Productos[0].Producto" class="text-danger"></span>
                </div>

                <div class="row mb-3">
                    <div class="col">
                        <label class="form-label">Cantidad</label>
                        <input name="Productos[0].Cantidad" type="number" min="1" class="form-control" placeholder="Ej. 1" />
                        <span asp-validation-for="Productos[0].Cantidad" class="text-danger"></span>
                    </div>
                    <div class="col">
                        <label class="form-label">Precio Unitario (₡)</label>
                        <input name="Productos[0].PrecioUnitario" type="number" step="0.01" min="0" class="form-control" placeholder="Ej. 1500.00" />
                        <span asp-validation-for="Productos[0].PrecioUnitario" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Método de Pago</label>
                    <select name="Pagos[0].Tipo" class="form-select">
                        <option value="">-- Seleccione --</option>
                        <option value="EFECTIVO">Efectivo</option>
                        <option value="TARJETA">Tarjeta</option>
                        <option value="SINPE">SINPE</option>
                    </select>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-success">Registrar Venta</button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
