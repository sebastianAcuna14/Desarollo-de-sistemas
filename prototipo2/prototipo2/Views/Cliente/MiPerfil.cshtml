@model prototipo2.Models.Cliente

@{
    ViewData["Title"] = "Mi Perfil";
    Layout = "_Layout";
}

<div class="container py-5 my-3">
    <!-- Padding y margin vertical -->
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <!-- Contenedor un poco más ancho -->
            <div class="card shadow-lg rounded-4">
                <!-- shadow-lg para más profundidad -->
                <div class="card-header bg-warning text-dark rounded-top-4 py-3">
                    <!-- Padding vertical en header -->
                    <div class="d-flex align-items-center">
                        <i class="fas fa-user-circle fs-3 me-3"></i> <!-- Icono más grande -->
                        <h2 class="mb-0">@ViewData["Title"]</h2> <!-- Título más destacado -->
                    </div>
                </div>

                <div class="card-body p-4">
                    <!-- Padding interno aumentado -->
                    <div class="row g-4 mb-4">
                        <!-- gutter entre columnas -->
                        <div class="col-md-6">
                            <div class="bg-light p-3 rounded-3">
                                <!-- Fondo más consistente -->
                                <h5 class="text-muted mb-3">Información Personal</h5> <!-- Subtítulo -->
                                <dl class="row g-2">
                                    <!-- Lista de definición mejorada -->
                                    <dt class="col-sm-4 fw-semibold">Nombre:</dt>
                                    <dd class="col-sm-8">@Model.Nombre</dd>

                                    <dt class="col-sm-4 fw-semibold">Apellido:</dt>
                                    <dd class="col-sm-8">@Model.Apellido</dd>

                                    <dt class="col-sm-4 fw-semibold">Cédula:</dt>
                                    <dd class="col-sm-8">@Model.Cedula</dd>
                                </dl>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="bg-light p-3 rounded-3">
                                <h5 class="text-muted mb-3">Contacto</h5>
                                <dl class="row g-2">
                                    <dt class="col-sm-4 fw-semibold">Teléfono:</dt>
                                    <dd class="col-sm-8">@Model.Telefonos</dd>

                                    <dt class="col-sm-4 fw-semibold">Correo:</dt>
                                    <dd class="col-sm-8">@Model.Correo</dd>
                                </dl>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-column flex-md-row justify-content-md-between align-items-center gap-3 mt-5 pt-3 border-top">
                        <!-- Botones responsivos -->
                        <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary flex-grow-1 flex-md-grow-0 w-100 w-md-auto">
                            <i class="fas fa-arrow-left me-2"></i>Volver al Inicio
                        </a>

                        <div class="d-flex flex-column flex-md-row gap-3 w-100 w-md-auto">

                            <a asp-action="EditarPerfil" asp-route-id="@Model.idCliente" class="btn btn-warning flex-grow-1">
                                <i class="fas fa-user-edit me-2"></i>Editar Perfil
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>