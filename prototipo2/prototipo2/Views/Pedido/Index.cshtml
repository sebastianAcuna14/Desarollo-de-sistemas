@model IEnumerable<prototipo2.Models.Pedido>

@{
    ViewData["Title"] = "Lista de Pedidos";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="container-sm py-3 col-11">

        <h1 class="mb-4">@ViewData["Title"]</h1>

        <a asp-controller="Pedido" asp-action="Crear" class="btn btn-primary mb-3">Crear Pedido</a>
        <a asp-controller="Pedido" asp-action="ExportarExcel" class="btn btn-success mb-3 ms-2">Exportar a Excel</a>

        <div class="card mt-4 shadow rounded-4">
            <div class="card-body">
                <table class="table table-striped" id="datatablesPedido" style="width:100%">
                    <thead class="table-secondary">
                        <tr>
                            <th>Número de Pedido</th>
                            <th>Nombre del Producto</th>
                            <th>Cantidad</th>
                            <th>Precio</th>
                            <th>Fecha del Pedido</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pedido in Model)
                        {
                            <tr class="@(pedido.Estado == "En camino" ? "table-warning" : "")">
                                <td>@pedido.Numero_Pedido</td>
                                <td>@pedido.Nombre_Producto</td>
                                <td>@pedido.Cantidad</td>
                                <td>₡@pedido.Precio.ToString("N2")</td>
                                <td>@pedido.FechaPedido.ToString("dd/MM/yyyy")</td>
                                <td>@pedido.Estado</td>
                                <td>
                                    <a asp-controller="Pedido"
                                       asp-action="Consultar"
                                       asp-route-id="@pedido.Id"
                                       class="btn btn-info btn-sm me-1">Ver</a>

                                    <a asp-controller="Pedido"
                                       asp-action="Editar"
                                       asp-route-id="@pedido.Id"
                                       class="btn btn-warning btn-sm me-1">Editar</a>

                                    <a asp-controller="Pedido"
                                       asp-action="Eliminar"
                                       asp-route-id="@pedido.Id"
                                       class="btn btn-danger btn-sm me-1">Eliminar</a>

                                    @if (pedido.Estado == "Preparando")
                                    {
                                        <form asp-controller="Pedido" asp-action="MarcarComoEnCamino" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@pedido.Id" />
                                            <button type="submit" class="btn btn-sm btn-warning">
                                                En camino
                                            </button>
                                        </form>
                                    }
                                    else if (pedido.Estado == "En camino")
                                    {
                                        <form asp-controller="Pedido" asp-action="MarcarComoEnviado" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@pedido.Id" />
                                            <button type="submit" class="btn btn-sm btn-success">
                                                Marcar como Enviado
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/umd/simple-datatables.min.js"></script>
    <script src="~/js/Pedido.js"></script>
}
