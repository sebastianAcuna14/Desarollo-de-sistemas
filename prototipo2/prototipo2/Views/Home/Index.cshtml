@using System.Linq
@model List<prototipo2.Models.Producto>
@{
    ViewData["Title"] = "Home Page";
}
@{
    var rol = Context.Session.GetString("Rol");
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ElectroMecánica - Inicio</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
   
    <!-- Custom CSS -->
	<link href="~/css/styles.css" rel="stylesheet" />

    @if (TempData["CompraExitosa"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                alert("¡Compra confirmada con éxito!");
            });
        </script>
    }
</head>
<body class="d-flex flex-column min-vh-">
    <nav class="navbar navbar-expand-lg navbar-dark sticky-top">
        <div class="container">
            <button class="navbar-toggler mx-auto" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-center" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link active px-4" href="index.html">Inicio</a>
                    </li>
                    <a asp-controller="Catalogo" asp-action="Index" class="nav-link text-dark">
                        Ver Productos
                    </a>

                    <li class="nav-item">
                        <a class="nav-link px-4" href="https://api.whatsapp.com/send?phone=50689551997l">Contactenos</a>
                    </li>
                    
                  
                     @if (rol == "Administrador")
                        {
                    <li class="nav-item">
                        <a class="nav-link px-4" asp-area="" asp-controller="Empleado" asp-action="ListaEmpleado">Administración</a>
                    </li> 
                        }
                    
                </ul>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero py-5">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6 mb-4 mb-lg-0">
                    <h1 class="display-4 fw-bold mb-3 text-dark">Soluciones Electromecánicas <span class="text-dark">de Calidad</span></h1>
                    <p class="fw-bold lead mb-4">Ofrecemos los mejores productos y servicios para todas sus necesidades electromecánicas.</p>
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-controller="Catalogo" asp-action="Index" class="btn btn-outline-dark">
                            Ver Catálogo
                        </a>
                      
                    </div>
                </div>
                <div class="col-lg-6">
                    <!-- Carrusel de Bootstrap -->
                    <div id="heroCarousel" class="carousel slide shadow rounded overflow-hidden" data-bs-ride="carousel">
                        <!-- Indicadores -->
                        <div class="carousel-indicators">
                            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
                            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
                        </div>

                        <!-- Slides -->
                        <div class="carousel-inner">
                            <div class="carousel-item active">
                                <img src="~/images/5 (1).jpg" class="d-block w-auto carousel-img" alt="Equipos Electromecánicos">
                                <div class="carousel-caption d-none d-md-block">
                                    
                                </div>
                            </div>
                            <div class="carousel-item">
                                <img src="~/images/2.jpg" class="d-block w-auto carousel-img" alt="Motores Industriales">
                                <div class="carousel-caption d-none d-md-block">
                                    
                                </div>
                            </div>
                            <div class="carousel-item">
                                <img src="~/images/4.jpg" class="d-block w-auto carousel-img" alt="Servicio Técnico">
                                <div class="carousel-caption d-none d-md-block">
                                   
                                </div>
                            </div>
                            <div class="carousel-item">
                                <img src="~/images/6.jpg" class="d-block w-auto carousel-img" alt="Servicio Técnico">
                                <div class="carousel-caption d-none d-md-block">
                                   
                                </div>
                            </div>
                            <div class="carousel-item">
                                <img src="~/images/8.jpg" class="d-block w-auto carousel-img" alt="Servicio Técnico">
                                <div class="carousel-caption d-none d-md-block">
                                </div>
                            </div>
                            <div class="carousel-item">
                                <img src="~/images/7.jpg" class="d-block w-auto carousel-img" alt="Servicio Técnico">
                                <div class="carousel-caption d-none d-md-block">
                                </div>
                            </div>

                           
                        </div>

                        <!-- Controles -->
                        <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Anterior</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Siguiente</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Servicios -->
    <section class="py-5 bg-light">
        <div class="container">
            <h2 class="text-center fw-bold mb-5">Nuestros Servicios</h2>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body text-center p-4">
                            <div class="rounded-circle bg-warning bg-opacity-25 p-3 d-inline-flex mb-4">
                                <i class="fas fa-tools fs-3 text-warning"></i>
                            </div>
                            <h3 class="card-title h5 fw-bold">Equipos de Calidad</h3>
                            <p class="card-text text-muted">Ofrecemos una amplia gama de equipos electromecánicos de las mejores marcas.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body text-center p-4">
                            <div class="rounded-circle bg-warning bg-opacity-25 p-3 d-inline-flex mb-4">
                                <i class="fas fa-truck fs-3 text-warning"></i>
                            </div>
                            <h3 class="card-title h5 fw-bold">Envíos Rápidos</h3>
                            <p class="card-text text-muted">Entregamos sus productos en tiempo récord a cualquier parte del país.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body text-center p-4">
                            <div class="rounded-circle bg-warning bg-opacity-25 p-3 d-inline-flex mb-4">
                                <i class="fas fa-headset fs-3 text-warning"></i>
                            </div>
                            <h3 class="card-title h5 fw-bold">Soporte Técnico</h3>
                            <p class="card-text text-muted">Brindamos asistencia técnica y mantenimiento para todos nuestros productos.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Productos Destacados -->
    <section class="py-5">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold mb-0">Productos Destacados</h2>
                <a asp-controller="Catalogo" asp-action="Index" class="text-decoration-none text-warning d-flex align-items-center">
                    Ver todos <i class="fas fa-chevron-right ms-1 small"></i>
                </a>
            </div>

            @if (Model != null && Model.Count > 0)
            {
                <div class="row g-4">
                    @foreach (var producto in Model)
                    {
                        string imgPath;

                        if (!string.IsNullOrEmpty(producto.ImagenUrl))
                        {
                            // Se respeta la ruta que viene desde la BD
                              imgPath = "/" + producto.ImagenUrl;
                        }
                         else
                        {
                            // Imagen por defecto si no hay URL
                            imgPath = Url.Content("~/images/6.jpg");
                          
                        } 

                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 border-0 shadow-sm">
                                <img src="@imgPath" class="card-img-top" alt="@producto.Nombre" style="height: 200px; object-fit: cover;">
                                <div class="card-body">
                                    @if (!string.IsNullOrEmpty(producto.NombreCategoria))
                                    {
                                        <span class="badge bg-warning text-dark mb-2">@producto.NombreCategoria</span>
                                    }
                                    <h5 class="card-title">@producto.Nombre</h5>
                                    <div class="d-flex justify-content-between align-items-center mt-3">
                                        <span class="fw-bold text-warning">@producto.Precio.ToString("C")</span>
                                        <form method="post" asp-controller="Carrito" asp-action="Agregar" class="m-0">
                                            <input type="hidden" name="ProductoId" value="@producto.IdProducto" />
                                            <input type="hidden" name="Nombre_Producto" value="@producto.Nombre" />
                                            <input type="hidden" name="Precio" value="@producto.Precio" />
                                            <input type="hidden" name="Cantidad" value="1" />
                                            <button type="submit" class="btn btn-sm btn-warning">
                                                Agregar
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">
                    <i class="fas fa-info-circle me-2"></i> No hay productos destacados disponibles.
                </div>
            }
        </div>
    </section>







    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
          var myCarousel = new bootstrap.Carousel(document.querySelector('#myCarousel'));
        });
    </script>
  
</body>
</html>